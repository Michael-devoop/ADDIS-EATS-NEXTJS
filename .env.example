# ==============================================================================
# Addis Eats - Environment Variables Specification (.env.example)
# ==============================================================================
# Security Rule: NEVER commit real production keys to version control.
# Copy this file to .env.local for local overrides (which is gitignored).
# Rule of Thumb: Secrets must NEVER use the NEXT_PUBLIC_ prefix!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server-Only Secrets (NEVER exposed to the browser bundle)
# ------------------------------------------------------------------------------
# Secret key used for signing and decrypting user session cookies
SESSION_SECRET=super_secret_session_signing_key_replace_in_production_min32chars

# Database connection URI or storage backend connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/addis_eats

# Internal communication token for background jobs and kitchen dispatch sync
INTERNAL_API_KEY=dev_internal_kitchen_dispatch_key_2026

# Node environment mode: 'development', 'production', or 'test'
NODE_ENV=development


# ------------------------------------------------------------------------------
# Public Client Variables (Inlined by Next.js compiler into the client JS bundle)
# WARNING: Values below are visible to anyone inspecting network requests or bundle code!
# ------------------------------------------------------------------------------
# Canonical application base URL for metadata, OpenGraph, and client redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public application branding title
NEXT_PUBLIC_SITE_NAME=Addis Eats

# Public measurement / analytics measurement ID (e.g. Google Analytics / Plausible)
NEXT_PUBLIC_ANALYTICS_ID=G-AE99DEMO12
